# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Database Persistence
# Default uses local SQLite for instant zero-dependency evaluation.
# To connect to PostgreSQL (Docker, Supabase, or Railway), uncomment and configure:
# DATABASE_URL=postgresql://lenny_user:lenny_password@localhost:5432/lenny_db
DATABASE_URL=sqlite:///lenny_assistant.db

# Active Model Provider Toggle: 'ollama' | 'anthropic' | 'openai' | 'mock'
DEFAULT_MODEL_PROVIDER=ollama

# Local LLM (Ollama) Settings - Mandatory for Take-Home Demo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TIMEOUT=180

# Cloud LLM Settings (Optional - leave blank if running purely on local Ollama)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# RAG & Grounding Parameters
RAG_GROUNDING_THRESHOLD=0.085
RAG_TOP_K=4

# CORS for production: comma-separated allowed origins
# Leave blank in development (localhost is automatically allowed)
# ALLOWED_ORIGINS=https://yourapp.com,https://www.yourapp.com
ALLOWED_ORIGINS=
